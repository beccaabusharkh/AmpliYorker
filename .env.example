# Project API key — also used at build time to inject Web Experiment CDN script in index.html
# (https://cdn.amplitude.com/script/<API_KEY>.experiment.js). Not the Web Experiment deployment key.
VITE_AMPLITUDE_API_KEY=
VITE_STATSIG_CLIENT_KEY=
VITE_AMPLITUDE_WEB_EXPERIMENT_DEPLOYMENT_KEY=

# Set to the string true to load Amplitude Guides & Surveys via @amplitude/unified engagement plugin.
# Production: set GitHub Actions secret VITE_AMPLITUDE_ENGAGEMENT_ENABLED (e.g. true) after the survey is published in Amplitude.
VITE_AMPLITUDE_ENGAGEMENT_ENABLED=